# ---------------------------------------------------------------------------
# Vouchify environment
# Copy to .env.local for development. Never commit .env.local.
# ---------------------------------------------------------------------------

# Public site origin. Used for canonical URLs, OpenGraph, sitemap, and the
# success/cancel URLs handed to Stripe Checkout.
# REQUIRED IN PRODUCTION. Without it the app now throws rather than silently
# redirecting paying customers to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe ----------------------------------------------------------------
# Secret key. Server only — never expose this to the client.
STRIPE_SECRET_KEY=sk_test_xxx
# Publishable key, safe in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook signing secret from `stripe listen` or the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Email (Resend) ----------------------------------------------------------
# Without a key, sendEmail() logs to the server console instead of sending.
# That covers the order confirmation, operator alerts, and quote-form
# notifications alike — they all go through the one function. Get the key
# from https://resend.com/api-keys, after verifying vouchify.ca as a sending
# domain at https://resend.com/domains.
RESEND_API_KEY=
# From-address for every outbound email. Must be on a domain verified in
# Resend, or every send is rejected. Falls back to orders@<site.url's host>
# when unset, so this only needs setting to use a different local part.
QUOTE_FROM_EMAIL=orders@vouchify.ca

# --- Forwarder storage ------------------------------------------------------
# Postgres connection string. Without it the store falls back to an in-memory
# adapter that does NOT persist between requests — fine locally, never in
# production. Apply src/lib/store/schema.sql before first use.
DATABASE_URL=

# Set to 1 to expose /api/dev/seed, which provisions a demo order so the
# forwarder and dashboard can be exercised without Stripe. Never set in production.
ENABLE_DEV_SEED=

# --- Operator access --------------------------------------------------------
# Opens /admin/fulfillment, the daily packing list. This one secret reads every
# order and every shipping address, so make it long and random:
#   openssl rand -hex 32
# Minimum 16 characters or the route refuses to serve.
ADMIN_TOKEN=
